<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="苹果皮网关"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本机作为通信网关,为 iPhone 提供短信/电话/语音服务。"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Broker 配置(MQTT,通常为 ZeroTier IP)"
            android:textSize="13sp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etBrokerHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="broker 主机/IP"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBrokerPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="端口(1883)"
            android:inputType="number"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMqttUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT 用户名"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMqttPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MQTT 密码"
            android:inputType="textPassword"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="设备ID(留空用默认)"
            android:inputType="text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卡1(槽0)/卡2(槽1) 本机号码(卡上没存,需手动填,仅用于显示)"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etSim0Number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="槽0 号码,如 13800138000"
            android:inputType="phone"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSim1Number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="槽1 号码(可留空)"
            android:inputType="phone"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存配置" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="启动网关" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBattery"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="申请电池优化白名单(防杀)"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
